{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blipcoard",
  "version": "0.1.0",
  "identifier": "com.acozy03.blipcoard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blipcoard",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/blipd",
      "binaries/blip"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local clipboard routing for agent workflows",
    "longDescription": "blipcoard mirrors clipboard events into a local, structured, auditable store and scopes agent access to user-selected workspaces.",
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
