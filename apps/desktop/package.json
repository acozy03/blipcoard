{
  "name": "@blipcoard/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "bundle:prepare-sidecars": "node ./scripts/prepare-sidecars.mjs",
    "bundle": "npm run bundle:prepare-sidecars && tauri build",
    "bundle:debug": "npm run bundle:prepare-sidecars && tauri build --debug",
    "bundle:check": "npm test && npm run build && npm run bundle:prepare-sidecars && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.9"
  }
}
